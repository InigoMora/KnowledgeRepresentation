    </owl:Class>
    


    <!-- http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#AnimalFood -->

    <owl:Class rdf:about="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#AnimalFood">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Food"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#contains"/>
                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Meat"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#contains"/>
                                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Seafood"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#FoodRestrictions"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Vegan_"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Vegetarian"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#AnimalProduct -->

