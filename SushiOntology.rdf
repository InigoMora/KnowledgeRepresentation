<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi/"
     xml:base="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi">
        <rdfs:comment xml:lang="en">Sushi antology for XM_0059 Knowledge Representattion, with Dr. P.S.H. Koopmann</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#contains -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#contains">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#ingredientOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Dishes"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Ingredients"/>
        <rdfs:comment>Contains an ingredient, it is made (partially) of</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#hasFoodRestriction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#hasFoodRestriction">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Food"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#FoodRestrictions"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#ingredientOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#ingredientOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Ingredients"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Dishes"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#AlgCrustacean -->

    <owl:Class rdf:about="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#AlgCrustacean">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Food"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#contains"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Crustacean"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#AlgShellfish"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#AlgFish -->

    <owl:Class rdf:about="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#AlgFish">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Food"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#contains"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Fish"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#AlgSeafood"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#AlgMollusk -->

