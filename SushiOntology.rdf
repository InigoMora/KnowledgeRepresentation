            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Allergies"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#contains"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Nuts"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#AlgSalmon -->

