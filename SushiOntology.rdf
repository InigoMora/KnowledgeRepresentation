                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Avocado"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#contains"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Crabs"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#contains"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/inigom/ontologies/2023/10/sushi#Cucumber"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
